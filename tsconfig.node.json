{
  "compilerOptions": {
    //指定 TypeScript 增量编译信息文件的存放路径，把临时缓存文件放到 node_modules 里，不污染项目根目录，
    //路径tsconfig.node.tsbuildinfo 通常是给 Vite 环境用的;专门给 vite.config.ts（Node 环境）做增量编译
    "incremental": true, // 开启增量编译
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.node.tsbuildinfo",
    "useDefineForClassFields": true, //强制 TypeScript 按照「现代浏览器标准」来编译 class 字段，让代码行为和浏览器原生行为完全一致
    "target": "ES2023",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "types": ["node"],
    "skipLibCheck": true, //忽略第三方库类型检查，只查自己代码，提速防坑

    /* Bundler mode */
    "moduleResolution": "bundler", //启用 打包器模块解析模式，适配 Vite、Webpack、Rollup 等现代打包工具，支持：import "./file" 不写后缀、package.json 中的 exports/imports 字段
    "allowImportingTsExtensions": true, //允许导入文件时显式写 .ts / .tsx 后缀；但 TS 默认禁止写 .ts 后缀的冲突
    "verbatimModuleSyntax": true, // 强制使用标准 ESM 语法，禁用非标准模块语法
    "moduleDetection": "force", //强制把所有文件当作独立模块处理
    "noEmit": true //TypeScript 只做类型检查，不生成任何 JS 文件
  }
}
